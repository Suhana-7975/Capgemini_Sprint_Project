<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Batch Suite">

  <!-- 1. Functional testing (group FT) -->
  <test name="Functional Testing">
    <groups>
      <run>
        <include name="FT"/>
      </run>
    </groups>
    <classes>
      <class name="com.swaglabs.login.LockedOutUserLoginTest"/>
      <class name="com.swaglabs.Checkout.CheckoutInformationTest"/>
      <class name="com.swaglabs.login.ValidLoginTest"/>
      <class name="com.swaglabs.Checkout.OrderCompletionTest"/>
      <class name="com.swaglabs.Product.AddToCartTest"/>
      <class name="com.swaglabs.Checkout.CheckoutOverviewTest"/>
      <class name="com.swaglabs.login.InvalidLoginTest"/>
      <class name="com.swaglabs.Product.ProductToCheckoutFlowTest"/>
    </classes>
  </test>

  <!-- 2. Integration testing (group IT) -->
  <test name="Integration Testing">
    <groups>
